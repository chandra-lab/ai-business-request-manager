# Application
APP_NAME=AIBRM
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# Security — change JWT_SECRET in any real deployment
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database
POSTGRES_USER=aibrm
POSTGRES_PASSWORD=aibrm_dev_password
POSTGRES_DB=aibrm
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://aibrm:aibrm_dev_password@postgres:5432/aibrm

# RabbitMQ / Celery
RABBITMQ_USER=aibrm
RABBITMQ_PASSWORD=aibrm_dev_password
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
CELERY_BROKER_URL=amqp://aibrm:aibrm_dev_password@rabbitmq:5672//
CELERY_RESULT_BACKEND=rpc://

# CORS (frontend origin)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# AI (optional — Phase 3; Mock is default, no key required)
AI_PROVIDER=mock
ANTHROPIC_API_KEY=

# Seed demo passwords (used only by seed script; documented in README)
SEED_DEMO_PASSWORD=DemoPass123!
